{
  "Server": {
    "Host": "ifbserver.ifb.local",
    "Port": 5001,
    "AutoDiscovery": true,
    "DiscoveryUdpPort": 5500,
    "DiscoveryTimeoutMs": 3000,
    "CertificateValidation": "SystemTrust",
    "ReconnectIntervalMs": 2000,
    "MaxReconnectAttempts": 20
  },
  "Theme": {
    "Default": "Auto",
    "ThemeFile": "Themes/theme.json"
  },
  "Notifications": {
    "ToastEnabled": true,
    "SoundEnabled": true,
    "SystemTrayEnabled": true
  },
  "Performance": {
    "ForcePerformanceMode": false,
    "MessageVirtualizationThreshold": 100
  }
}
