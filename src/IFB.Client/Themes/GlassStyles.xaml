<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ColorTokens.xaml"/>
        <ResourceDictionary Source="TypographyStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Native templates preserve keyboard, disabled, focus and contrast states. -->
    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="24"/>
    </Style>
    <Style x:Key="GlassCardElevatedStyle" TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
        <Setter Property="Background" Value="{ThemeResource GlassOverlayBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
    </Style>
    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>
    <Style x:Key="AccentGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="IconGlassButtonStyle" TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="GlassListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="MinHeight" Value="52"/>
    </Style>
    <Style x:Key="GlassSearchBoxStyle" TargetType="AutoSuggestBox">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource GlassButtonStyle}"/>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="ItemContainerStyle" Value="{StaticResource GlassListViewItemStyle}"/>
    </Style>
</ResourceDictionary>

