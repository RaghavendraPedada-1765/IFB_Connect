<?xml version="1.0" encoding="utf-8"?>
<!--
  MainWindow.xaml — Three-pane glass layout:
  [Icon Rail] [Conversation List] [Chat Area + Details Panel]
  Custom title bar extends into the window chrome.
-->
<Window
    x:Class="IFB.Client.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:IFB.Client.Controls"
    xmlns:views="using:IFB.Client.Views"
    mc:Ignorable="d"
    Title="IFB Connect">

    <!-- Root: login frame + three-pane shell, toggled by NavigateToLogin/NavigateToMain -->
    <Grid>
        <!-- Login frame — full-screen before auth -->
        <Frame x:Name="LoginFrame" Visibility="Collapsed" />

        <!-- Three-pane shell -->
        <Grid x:Name="RootGrid" Background="Transparent" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Custom title bar -->
            <RowDefinition Height="*" />     <!-- Main content -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ANIMATED GRADIENT MESH BACKGROUND                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="2" x:Name="BackgroundMesh" Opacity="0.12">
            <!-- Layer 1: base dark gradient -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource Bg0}" Offset="0"/>
                        <GradientStop Color="{ThemeResource Bg1}" Offset="0.5"/>
                        <GradientStop Color="{ThemeResource Bg2}" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Layer 2: IFB Blue radial blob (top-left) -->
            <Ellipse
                Width="600" Height="400"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="-100,-150,0,0"
                Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{StaticResource AccentPrimary}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Layer 3: Deep purple accent (bottom-right) -->
            <Ellipse
                Width="500" Height="400"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-100,-100"
                Opacity="0.12">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B1FA0" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Layer 4: Teal accent (center) -->
            <Ellipse
                Width="350" Height="350"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Margin="200,0,0,0"
                Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#0EA5E9" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR                                               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- Drag region left -->
                <ColumnDefinition Width="Auto"/>   <!-- Logo + title -->
                <ColumnDefinition Width="*"/>      <!-- Draggable center -->
                <ColumnDefinition Width="Auto"/>   <!-- Connection status -->
                <ColumnDefinition Width="Auto"/>   <!-- Window buttons (system) -->
            </Grid.ColumnDefinitions>

            <!-- Left drag spacer -->
            <Border Grid.Column="0" Width="12" IsHitTestVisible="False"/>

            <!-- App logo + name -->
            <Border Grid.Column="1" Background="White" CornerRadius="6"
                    Padding="8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="ms-appx:///Assets/Branding/ifb-connect-logo.png"
                       Width="164" Height="34" Stretch="Uniform"
                       AutomationProperties.Name="IFB Connect logo"/>
            </Border>

            <!-- Draggable center area -->
            <Button x:Name="GlobalSearchButton" Grid.Column="2" Content="Search people and conversations    Ctrl+K" Click="GlobalSearch_Click" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280" Height="28" FontSize="11" CornerRadius="14" Padding="14,2" Background="{ThemeResource SurfaceBrush}" BorderThickness="0"/>

            <!-- Connection status pill -->
            <Border Grid.Column="3" VerticalAlignment="Center"
                    Margin="0,0,8,0" Padding="8,3"
                    CornerRadius="12"
                    Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                             Fill="{StaticResource PresenceOnlineBrush}">
                        <Ellipse.RenderTransform>
                            <ScaleTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="ConnectionLabel" Tapped="Reconnect_Click"
                               Text="Connected"
                               Style="{StaticResource CaptionStyle}"
                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MAIN THREE-PANE LAYOUT                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Icon rail: 56px slim navigation bar -->
                <ColumnDefinition Width="52"/>
                <!-- Conversation list: 280px, resizable -->
                <ColumnDefinition Width="258" MinWidth="232" MaxWidth="320"/>
                <!-- Splitter -->
                <ColumnDefinition Width="1"/>
                <!-- Main chat area -->
                <ColumnDefinition Width="*"/>
                <!-- Details/info panel: collapsible -->
                <ColumnDefinition x:Name="DetailsPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ── ICON RAIL (Glass Level 1) ────────────────────────────── -->
            <Border Grid.Column="0"
                    x:Name="IconRail"
                    Background="{ThemeResource Glass1Brush}"
                    BorderBrush="{ThemeResource GlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <StackPanel VerticalAlignment="Top" Margin="0,8,0,0" Spacing="2">

                        <!-- User avatar (top) -->
                        <controls:PresenceAvatar
                            x:Name="SelfAvatar"
                            Margin="8,8,8,16"
                            Size="36"
                            HorizontalAlignment="Center"/>

                        <!-- Nav: Chats -->
                        <controls:NavRailButton
                            x:Name="NavChats"
                            Tag="Chats"
                            Icon="&#xE8BD;"
                            Label="Chats"
                            IsSelected="True"
                            Click="NavButton_Click"/>

                        <!-- Nav: Channels -->
                        <controls:NavRailButton
                            Tag="Channels"
                            Icon="&#xE7EF;"
                            Label="Channels"
                            Click="NavButton_Click"/>

                        <!-- Nav: Directory -->
                        <controls:NavRailButton
                            Tag="Directory"
                            Icon="&#xE77B;"
                            Label="Directory"
                            Click="NavButton_Click"/>

                        <!-- Nav: Files -->
                        <controls:NavRailButton
                            Tag="Files"
                            Icon="&#xE8A5;"
                            Label="Files"
                            Click="NavButton_Click"/>

                    </StackPanel>

                    <!-- Bottom: Settings -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8" Spacing="2">
                        <controls:NavRailButton
                            Tag="Settings"
                            Icon="&#xE713;"
                            Label="Settings"
                            Click="NavButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── CONVERSATION LIST (Glass Level 2) ─────────────────────── -->
            <Border Grid.Column="1"
                    x:Name="ConversationListPane"
                    Background="{ThemeResource Glass2Brush}"
                    BorderBrush="{ThemeResource GlassBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Pane header + search -->
                        <RowDefinition Height="Auto"/>  <!-- Announcements banner -->
                        <RowDefinition Height="*"/>     <!-- Conversation list -->
                        <RowDefinition Height="Auto"/>  <!-- New conversation fab -->
                    </Grid.RowDefinitions>

                    <!-- Pane header -->
                    <Grid Grid.Row="0" Padding="16,8" Height="48" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="Chats"
                            x:Name="PaneTitle"
                            Style="{StaticResource SubtitleStyle}"
                            Foreground="{ThemeResource TextPrimaryBrush}"
                            VerticalAlignment="Center"/>

                        <!-- Compose / New chat button -->
                        <Button Grid.Column="1"
                                Style="{StaticResource IconGlassButtonStyle}"
                                Content="&#xE70F;"
                                FontFamily="Segoe Fluent Icons"
                                ToolTipService.ToolTip="New Conversation"
                                Click="NewConversation_Click"/>
                    </Grid>

                    <!-- Search box -->
                    <AutoSuggestBox
                        Grid.Row="0"
                        Margin="12,54,12,14"
                        VerticalAlignment="Bottom"
                        PlaceholderText="Search conversations..."
                        QueryIcon="Find"
                        Style="{StaticResource GlassSearchBoxStyle}"
                        TextChanged="Search_TextChanged"/>

                    <!-- Priority announcement banner -->
                    

                    <!-- Conversation list (virtualized) -->
                    <ListView
                        Grid.Row="2"
                        x:Name="ConversationList"
                        Padding="8,0"
                        SelectionMode="Single"
                        SelectionChanged="Conversation_Selected"
                        ItemContainerStyle="{StaticResource GlassListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <controls:ChatListItem
                                    ConversationName="{Binding Name}"
                                    LastMessage="{Binding LastMessagePreview}"
                                    Timestamp="{Binding LastActivity}"
                                    UnreadCount="{Binding UnreadCount}"
                                    AvatarUrl="{Binding AvatarUrl}"
                                    IsGroup="{Binding IsGroup}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- FAB: new conversation -->
                    <Button Grid.Row="3"
                            Margin="16,8"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentGlassButtonStyle}"
                            Content="+ New Conversation"
                            Click="NewConversation_Click"/>
                </Grid>
            </Border>

            <!-- ── VERTICAL SPLITTER ──────────────────────────────────────── -->
            <Border Grid.Column="2" Background="{ThemeResource GlassBorderBrush}"/>

            <!-- ── MAIN CHAT AREA (Glass Level 3) ────────────────────────── -->
            <Border Grid.Column="3"
                    x:Name="ChatAreaPane"
                    Background="{ThemeResource Glass3Brush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<controls:AnnouncementBanner
                        Grid.Row="0"
                        x:Name="AnnouncementBannerControl"
                        Visibility="Collapsed"
                        Margin="16,12,16,0"/>
<!-- Frame for navigating between views (Chat, Directory, etc.) -->
                    <Frame Grid.Row="1" x:Name="MainFrame"
                          />

                    <!-- Empty state when no conversation selected -->
                    <StackPanel
                        x:Name="EmptyState" Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Opacity="0.7">
                        <Viewbox Width="80" Height="80">
                            <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                  Fill="{StaticResource AccentPrimaryBrush}" Stretch="Uniform"/>
                        </Viewbox>
                        <TextBlock Text="Select a conversation"
                                   Style="{StaticResource SubtitleStyle}"
                                   Foreground="{ThemeResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <Button Content="Start a conversation" Click="NewConversation_Click" Style="{StaticResource AccentGlassButtonStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Or press Ctrl+K to search"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="{ThemeResource TextDisabledBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Command palette overlay (Ctrl+K) -->
                    <controls:CommandPalette
                        x:Name="CommandPaletteControl" Grid.RowSpan="2"
                        Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- ── DETAILS PANEL (collapsible) ───────────────────────────── -->
            <Border Grid.Column="4"
                    x:Name="DetailsPanel"
                    Background="{ThemeResource Glass2Brush}"
                    BorderBrush="{ThemeResource GlassBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <Frame x:Name="DetailsFrame"/>
            </Border>

        </Grid>

    </Grid>
    </Grid>
</Window>



