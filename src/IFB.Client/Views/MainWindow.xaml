<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="IFB.Client.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:IFB.Client.Controls" Title="IFB Connect">
<Grid>
    <Frame x:Name="LoginFrame" Visibility="Collapsed"/>
    <Grid x:Name="RootGrid" Background="{ThemeResource Bg0Brush}" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="BackgroundMesh" Grid.RowSpan="2" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Grid x:Name="AppTitleBar" Height="56" Padding="20,0,144,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Background="{ThemeResource AccentPrimaryBrush}" CornerRadius="10" Width="30" Height="30">
                    <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="16"/>
                </Border>
                <TextBlock Text="IFB Connect" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
            </StackPanel>
            <Button x:Name="GlobalSearchButton" Grid.Column="1" Click="GlobalSearch_Click" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Height="36" Padding="16,6" CornerRadius="10" Background="{ThemeResource SurfaceBrush}" BorderThickness="0" AutomationProperties.Name="Search people and conversations">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE721;" FontSize="13"/>
                    <TextBlock Text="Search IFB Connect" FontSize="13"/>
                    <TextBlock Text="Ctrl+K" FontSize="11" Opacity="0.65" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource PresenceOnlineBrush}"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                <TextBlock x:Name="ConnectionLabel" Text="Connected" Tapped="Reconnect_Click" Style="{StaticResource CaptionStyle}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="12,0,12,12" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172"/>
                <ColumnDefinition x:Name="ConversationPaneColumn" Width="286"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="DetailsPanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconRail" Background="{ThemeResource Glass1Brush}" CornerRadius="20,0,0,20" Padding="10,18,10,12">
                <Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource LabelStyle}" Margin="14,0,0,10"/>
                        <controls:NavRailButton x:Name="NavChats" Tag="Chats" Icon="&#xE8BD;" Label="Messages" IsSelected="True" Click="NavButton_Click"/>
                        <controls:NavRailButton Tag="Channels" Icon="&#xE7EF;" Label="Channels" Click="NavButton_Click"/>
                        <controls:NavRailButton Tag="Directory" Icon="&#xE77B;" Label="People" Click="NavButton_Click"/>
                        <controls:NavRailButton Tag="Files" Icon="&#xE8A5;" Label="Files" Click="NavButton_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Spacing="12">
                        <controls:NavRailButton Tag="Settings" Icon="&#xE713;" Label="Settings" Click="NavButton_Click"/>
                        <Border BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="10,16,4,4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <controls:PresenceAvatar x:Name="SelfAvatar" Size="32"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="SelfName" Text="Your workspace" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                    <TextBlock Text="IFB Automotive" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="ConversationListPane" Grid.Column="1" Background="{ThemeResource Glass2Brush}" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="0,0,1,0">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Padding="20,20,20,0" Spacing="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PaneTitle" Text="Messages" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Your conversations" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource IconGlassButtonStyle}" Content="&#xE70F;" ToolTipService.ToolTip="New conversation" AutomationProperties.Name="New conversation" Click="NewConversation_Click"/>
                        </Grid>
                        <AutoSuggestBox PlaceholderText="Search conversations" QueryIcon="Find" Style="{StaticResource GlassSearchBoxStyle}" TextChanged="Search_TextChanged"/>
                    </StackPanel>
                    <ListView Grid.Row="1" x:Name="ConversationList" Padding="10,0" SelectionMode="Single" SelectionChanged="Conversation_Selected" ItemContainerStyle="{StaticResource GlassListViewItemStyle}">
                        <ListView.ItemTemplate><DataTemplate>
                            <controls:ChatListItem ConversationName="{Binding Name}" LastMessage="{Binding LastMessagePreview}" Timestamp="{Binding LastActivity}" UnreadCount="{Binding UnreadCount}" AvatarUrl="{Binding AvatarUrl}" IsGroup="{Binding IsGroup}"/>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Button Grid.Row="2" Margin="18,0,18,18" HorizontalAlignment="Stretch" Style="{StaticResource AccentGlassButtonStyle}" Content="New message" Click="NewConversation_Click"/>
                </Grid>
            </Border>
            <Border x:Name="ChatAreaPane" Grid.Column="2" Background="{ThemeResource Glass3Brush}" CornerRadius="0,20,20,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <controls:AnnouncementBanner x:Name="AnnouncementBannerControl" Grid.Row="0" Visibility="Collapsed" Margin="24,20,24,0"/>
                    <Frame x:Name="MainFrame" Grid.Row="1"/>
                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="340" Margin="28">
                        <Border Background="{ThemeResource AccentSubtleBrush}" CornerRadius="24" Width="88" Height="88" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="34" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                        </Border>
                        <TextBlock Text="A little closer to your team." FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="Choose a conversation or start a new one. Everything your team shares stays in your workspace." Style="{StaticResource BodyStyle}" TextAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}"/>
                        <Button Content="Start a conversation" Click="NewConversation_Click" Style="{StaticResource AccentGlassButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="Find people quickly with Ctrl+K" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DetailsPanel" Grid.Column="3" Background="{ThemeResource Glass2Brush}" Visibility="Collapsed"><Frame x:Name="DetailsFrame"/></Border>
        </Grid>
        <controls:CommandPalette x:Name="CommandPaletteControl" Grid.RowSpan="2" Visibility="Collapsed"/>
    </Grid>
</Grid>
</Window>
