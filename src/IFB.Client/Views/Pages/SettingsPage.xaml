<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IFB.Client.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="32">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="24">

            <TextBlock Text="Settings" Style="{StaticResource TitleStyle}"
                       Foreground="{ThemeResource TextPrimaryBrush}"/>

            <!-- Appearance section -->
            <StackPanel Spacing="8">
                <TextBlock Text="APPEARANCE" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="16">
                        <!-- Theme selector -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="App theme" Style="{StaticResource BodyStrongStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Choose your preferred colour scheme"
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedIndex="0" MinWidth="130">
                                <ComboBoxItem Content="System default"/>
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource GlassBorderBrush}"/>
                        <!-- Performance mode -->
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Performance mode" Style="{StaticResource BodyStrongStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Disables glass effects on low-end machines"
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="False"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Notifications section -->
            <StackPanel Spacing="8">
                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Toast notifications" Style="{StaticResource BodyStrongStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Show pop-up alerts for new messages"
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource GlassBorderBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Sound effects" Style="{StaticResource BodyStrongStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Play sound for new messages"
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="True"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource GlassBorderBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Do Not Disturb" Style="{StaticResource BodyStrongStyle}"
                                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                                <TextBlock Text="Suppress all notifications"
                                           Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsOn="False"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- About section -->
            <StackPanel Spacing="8">
                <TextBlock Text="ABOUT" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="IFB Connect" Style="{StaticResource BodyStrongStyle}"
                                   Foreground="{ThemeResource TextPrimaryBrush}"/>
                        <TextBlock Text="Version 1.0.0 · Phase 0 (Visual Shell)"
                                   Style="{StaticResource CaptionStyle}"/>
                        <TextBlock Text="Internal use only — IFB Automotive"
                                   Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sign out -->
            <Button Content="Sign Out" HorizontalAlignment="Left"
                    Foreground="{StaticResource UrgentBrush}"
                    Style="{StaticResource GlassButtonStyle}"/>

        </StackPanel>
    </ScrollViewer>
</Page>

