<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="IFB.Client.Views.Pages.LoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{ThemeResource Bg0Brush}">
<Grid x:Name="LoginLayout" Padding="32">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrandColumn" Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
    <Border x:Name="BrandPanel" CornerRadius="28" Margin="0,0,24,0" Padding="36" Background="#123453">
        <Grid>
            <StackPanel VerticalAlignment="Top" Spacing="14">
                <Border Background="White" CornerRadius="14" Padding="16,10" MaxWidth="300" HorizontalAlignment="Left">
                    <Image Source="ms-appx:///Assets/Branding/ifb-connect-logo.png" Height="64" Stretch="Uniform" AutomationProperties.Name="IFB Connect"/>
                </Border>
                <TextBlock Text="YOUR TEAM. CONNECTED." FontSize="11" CharacterSpacing="100" Foreground="#BACEE2" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Spacing="20" Margin="0,80,0,48">
                <TextBlock Text="Good work starts with a conversation." FontSize="36" FontWeight="SemiBold" CharacterSpacing="-20" TextWrapping="Wrap" Foreground="White"/>
                <TextBlock Text="A focused space for your people, conversations and everyday collaboration." FontSize="15" LineHeight="24" TextWrapping="Wrap" Foreground="#D5E3F0"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Spacing="12">
                <Border Height="1" Background="#40607F" Margin="0,0,0,8"/>
                <TextBlock Text="Private company workspace" Foreground="#E1EBF5" FontSize="13"/>
                <TextBlock Text="Messages  ·  Channels  ·  Shared files" Foreground="#BACEE2" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="620">
            <Border MaxWidth="420" Margin="20" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{ThemeResource SurfaceBrush}" CornerRadius="24" BorderBrush="{ThemeResource GlassBorderBrush}" BorderThickness="1" Padding="32">
                <StackPanel Spacing="0">
                    <Border Width="44" Height="44" Background="{ThemeResource AccentSubtleBrush}" CornerRadius="14" HorizontalAlignment="Left" Margin="0,0,0,24">
                        <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="Welcome back." Style="{StaticResource TitleStyle}"/>
                    <TextBlock Text="Sign in to your IFB workspace." Style="{StaticResource BodyStyle}" Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,8,0,24"/>
                    <Border x:Name="DiscoveryStatus" CornerRadius="12" Background="{ThemeResource Bg1Brush}" Padding="12" Margin="0,0,0,22">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="DiscoveryRing" Width="16" Height="16" IsActive="{Binding IsDiscovering}" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            <TextBlock x:Name="DiscoveryLabel" Grid.Column="1" Text="{Binding DiscoveryStatus}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Your company username" KeyDown="InputField_KeyDown" Margin="0,0,0,18" AutomationProperties.Name="Username"/>
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" PlaceholderText="Enter your password" KeyDown="InputField_KeyDown" Margin="0,0,0,18" AutomationProperties.Name="Password"/>
                    <Border x:Name="ErrorBorder" CornerRadius="12" Background="{ThemeResource AccentSubtleBrush}" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorLabel" FontSize="13" Foreground="{ThemeResource UrgentBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </Border>
                    <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource AccentGlassButtonStyle}" HorizontalAlignment="Stretch" Height="46" Click="Login_Click"/>
                    <Button Content="Continue with Windows" Click="WindowsLogin_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                    <HyperlinkButton Content="Server connection settings" HorizontalAlignment="Center" FontSize="12" Click="ManualConfig_Click" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Grid>
</Page>
