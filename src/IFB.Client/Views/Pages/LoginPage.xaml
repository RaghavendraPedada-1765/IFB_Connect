<?xml version="1.0" encoding="utf-8"?>
<!--
  LoginPage.xaml — Full-window glass login screen.
  Left: animated gradient/brand side. Right: frosted glass card with form.
-->
<Page
    x:Class="IFB.Client.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Brand panel: 45% -->
            <ColumnDefinition Width="0.45*"/>
            <!-- Login form: 55% -->
            <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LEFT: BRAND PANEL                                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <!-- Deep gradient -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#040C1E" Offset="0"/>
                        <GradientStop Color="#0055A5" Offset="0.6"/>
                        <GradientStop Color="#003D7A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Mesh blobs -->
            <Ellipse Width="400" Height="400" HorizontalAlignment="Right"
                     VerticalAlignment="Top" Margin="0,-100,-100,0" Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1E7FE0" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left"
                     VerticalAlignment="Bottom" Margin="-50,0,0,-50" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B1FA0" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Brand content -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="24" Padding="40">

                <Border Background="White" CornerRadius="16" Padding="16,8" MaxWidth="420">
                    <Image Source="ms-appx:///Assets/Branding/ifb-connect-logo.png"
                           Width="360" Height="120" Stretch="Uniform"
                           AutomationProperties.Name="IFB Connect logo"/>
                </Border>

                <StackPanel Spacing="8">

                    <TextBlock Text="Internal Communications Platform"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="14" FontWeight="Normal"
                               Foreground="#B0C8E8"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Feature highlights -->
                <StackPanel Spacing="12" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons"
                                   FontSize="16" Foreground="#80CCEE" VerticalAlignment="Center"/>
                        <TextBlock Text="Secure LAN-only messaging"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="13" Foreground="#A0C4E8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons"
                                   FontSize="16" Foreground="#80CCEE" VerticalAlignment="Center"/>
                        <TextBlock Text="Windows authentication"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="13" Foreground="#A0C4E8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe Fluent Icons"
                                   FontSize="16" Foreground="#80CCEE" VerticalAlignment="Center"/>
                        <TextBlock Text="Channels for every department"
                                   FontFamily="Segoe UI Variable, Segoe UI"
                                   FontSize="13" Foreground="#A0C4E8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RIGHT: LOGIN FORM                                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- Frosted glass login card -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="400"
                CornerRadius="20"
                BorderThickness="1"
                BorderBrush="{ThemeResource GlassBorderBrush}"
                Padding="36,40">
                <Border.Background><SolidColorBrush Color="{ThemeResource SurfaceColor}"/></Border.Background>

                <StackPanel Spacing="0">
                    <!-- Form header -->
                    <TextBlock Text="Sign in"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Use your IFB company credentials"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Margin="0,0,0,28"/>

                    <!-- Server discovery status -->
                    <Border x:Name="DiscoveryStatus" CornerRadius="8"
                            Background="#10FFFFFF" BorderBrush="#20FFFFFF"
                            BorderThickness="1" Padding="12,8" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="DiscoveryRing" Width="14" Height="14"
                                          IsActive="{Binding IsDiscovering}"
                                          Foreground="{StaticResource AccentPrimaryLightBrush}"/>
                            <TextBlock x:Name="DiscoveryLabel"
                                       Text="{Binding DiscoveryStatus}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Username field -->
                    <TextBlock Text="Username"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox
                        x:Name="UsernameBox"
                        Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="domain\username or username"
                        FontFamily="Segoe UI Variable, Segoe UI"
                        Margin="0,0,0,16"
                        KeyDown="InputField_KeyDown"/>

                    <!-- Password field -->
                    <TextBlock Text="Password"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox
                        x:Name="PasswordBox"
                        PasswordChanged="PasswordBox_PasswordChanged"
                        PlaceholderText="Your Windows password"
                        FontFamily="Segoe UI Variable, Segoe UI"
                        Margin="0,0,0,8"
                        KeyDown="InputField_KeyDown"/>

                    <!-- Error message -->
                    <Border x:Name="ErrorBorder" CornerRadius="8"
                            Background="#20EF4444" BorderBrush="#40EF4444"
                            BorderThickness="1" Padding="12,8" Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorLabel"
                                   FontSize="13"
                                   Foreground="#FFEF9090"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Sign in button -->
                    <Button
                        x:Name="LoginButton"
                        Content="Sign In"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentGlassButtonStyle}"
                        Height="44"
                        FontSize="15"
                        Click="Login_Click"
                        Margin="0,8,0,0"/>

                    <!-- Divider -->
                    <Button Content="Sign in with Windows" Click="WindowsLogin_Click" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    <Grid Margin="0,20,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{ThemeResource GlassBorderBrush}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="or" Margin="12,0"
                                   FontSize="11" Foreground="{ThemeResource TextDisabledBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Height="1" Background="{ThemeResource GlassBorderBrush}"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Manual server config -->
                    <HyperlinkButton Content="Configure server manually"
                                     HorizontalAlignment="Center"
                                     FontSize="12"
                                     Click="ManualConfig_Click"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>


