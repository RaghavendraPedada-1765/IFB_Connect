<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IFB.Client.Views.Pages.FilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <Grid Padding="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="56"
                       HorizontalAlignment="Center" Foreground="{StaticResource AccentPrimaryBrush}" Opacity="0.7"/>
            <TextBlock Text="Shared Files" Style="{StaticResource TitleStyle}"
                       HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
            <TextBlock Text="Files shared across all conversations appear here"
                       Style="{StaticResource BodyStyle}" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</Page>

