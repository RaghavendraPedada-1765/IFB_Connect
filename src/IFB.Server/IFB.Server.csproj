<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IFB.Server</RootNamespace>
    <AssemblyName>IFB.Server</AssemblyName>
    <UserSecretsId>ifb-server-secrets</UserSecretsId>
    <!-- Product details shown in the .exe's Properties → Details -->
    <Version>1.0.0</Version>
    <Product>IFB Connect</Product>
    <Company>IFB Automotive</Company>
    <Authors>Raghavendra Pedada</Authors>
    <Copyright>© 2026 IFB Automotive. All rights reserved.</Copyright>
    <Description>IFB Connect server. Developed by Raghavendra Pedada.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IFB.Shared\IFB.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + providers -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.31" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31" PrivateAssets="all" />

    <!-- Windows Service host -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />

    <!-- Auth — AD -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.1" />

    <!-- JWT -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.31" />

    <!-- Password hashing -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

</Project>


